# ==================
# S3 Object Storage
# ==================
#
# RustFS is the S3-compatible object store backing the lakehouse.
#
# - S3_ENDPOINT and S3_URL_STYLE are only required for S3-compatible stores
# - The RustFS web console (default: http://localhost:9001/rustfs/console) uses a
#   separate login from the S3 root credentials used below

S3_ENDPOINT=localhost:9000
S3_USE_SSL=false
S3_URL_STYLE=path
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_REGION=us-east-1

# ==================
# PostgreSQL
# ==================
#
# - PSQL_ROOT_PASSWORD is only used when running the bundled docker compose service
# - PSQL_CATALOG_* describe the DuckLake metadata backend and the PostgreSQL client
#   used by `dlctl backup`
#
# Every PSQL_CATALOG_*_SCHEMA below is a DuckLake catalog. Adding a mart means adding
# a *_MART_SCHEMA variable plus the matching S3_*_PREFIX variable.

PSQL_ROOT_PASSWORD=password

PSQL_CATALOG_HOST=127.0.0.1
PSQL_CATALOG_PORT=5432
PSQL_CATALOG_DB=lakehouse
PSQL_CATALOG_USER=postgres
PSQL_CATALOG_PASSWORD=password

PSQL_CATALOG_STAGE_SCHEMA=stage
PSQL_CATALOG_SECURE_STAGE_SCHEMA=secure_stage
PSQL_CATALOG_GRAPHS_MART_SCHEMA=graphs
PSQL_CATALOG_ANALYTICS_MART_SCHEMA=analytics

# ========
# Data Lab
# ========

S3_BUCKET=lakehouse
S3_INGEST_PREFIX=raw
S3_STAGE_PREFIX=stage
S3_SECURE_STAGE_PREFIX=secure-stage
S3_GRAPHS_MART_PREFIX=marts/graphs
S3_ANALYTICS_MART_PREFIX=marts/analytics
S3_EXPORTS_PREFIX=exports
S3_BACKUPS_PREFIX=backups

# ========
# DuckLake
# ========
#
# - Paths are relative to local/

ENGINE_DB=engine.duckdb
