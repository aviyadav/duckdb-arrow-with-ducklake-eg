# =======
# Configs
# =======

# Recipes below are POSIX shell scripts. `bash` is deliberately not used: on Windows
# it can resolve to the WSL launcher (C:\Windows\System32\bash.exe), which cannot see
# the project tooling. `sh` resolves to Git for Windows instead.
set shell := ["sh", "-uc"]
set dotenv-load

# Project tooling runs through uv, so recipes work whether or not the virtual
# environment is active in the calling shell.
uv := "uv run"

# -----
# Paths
# -----

local_dir := "local/"
init_sql_path := join(local_dir, "init.sql")
engine_db_path := join(local_dir, env_var("ENGINE_DB"))

# --------
# Datasets
# --------

ds_dsn_url := "https://www.kaggle.com/datasets/andreagarritano/deezer-social-networks"
ds_msdsl_url := "https://www.kaggle.com/datasets/undefinenull/million-song-dataset-spotify-lastfm"
ds_dd_url := "https://huggingface.co/datasets/ShreyaR/DepressionDetection"
ds_dd_monitor_url := "https://huggingface.co/datasets/joangaes/depression"


# ======
# Common
# ======

default:
    @"{{just_executable()}}" -l

# Check any binary, e.g. `just check terraform`
check binary:
    @command -v {{binary}} >/dev/null 2>&1 \
        && echo "{{binary}}: ok" \
        || (echo "{{binary}}: not found"; exit 1)

check-dlctl:
    @{{uv}} python -c "import importlib.metadata as m; m.version('datalab')" >/dev/null 2>&1 \
        && echo "dlctl: ok" \
        || (echo "dlctl: not installed - run 'uv sync'"; exit 1)

check-duckdb:
    @command -v duckdb >/dev/null 2>&1 \
        && echo "duckdb: ok" \
        || (echo "duckdb: not found - install the DuckDB CLI"; exit 1)

check-docker:
    @command -v docker >/dev/null 2>&1 \
        && echo "docker: ok" \
        || (echo "docker: not found"; exit 1)

check-git:
    @command -v git >/dev/null 2>&1 \
        && echo "git: ok" \
        || (echo "git: not found"; exit 1)

check-uv:
    @command -v uv >/dev/null 2>&1 \
        && echo "uv: ok" \
        || (echo "uv: not found - see https://docs.astral.sh/uv/"; exit 1)

confirm:
    #!/bin/bash
    while true; do
        read -p "Are you sure? [y/N] " yn
        yn=${yn:-N}
        case $yn in
            [Yy]*) exit 0;;
            [Nn]*) exit 1;;
        esac
    done


# ===========
# Development
# ===========

check-dev: check-git check-uv

setup-dev:
    "{{just_executable()}}" check git || sudo apt install -y git
    "{{just_executable()}}" check uv || curl -LsSf https://astral.sh/uv/install.sh | sh


# ========
# DuckLake
# ========

check-init-sql:
    test -r {{init_sql_path}} || "{{just_executable()}}" generate-init-sql

generate-init-sql: check-dlctl
    {{uv}} dlctl tools generate-init-sql --path {{init_sql_path}}

# Create the RustFS bucket and the PostgreSQL catalog database, then write init.sql
init: check-dlctl
    {{uv}} dlctl tools create-bucket
    {{uv}} dlctl tools init-catalog
    "{{just_executable()}}" generate-init-sql

lakehouse: check-duckdb check-init-sql
    duckdb -init {{init_sql_path}} {{engine_db_path}}

backup-create: check-dlctl
    {{uv}} dlctl backup create

backup-ls: check-dlctl
    {{uv}} dlctl backup ls -a

backup-restore: check-dlctl
    {{uv}} dlctl backup restore


# =====================
# GraphRAG: Music Taste
# =====================

graphrag-ingest: check-dlctl
    {{uv}} dlctl ingest dataset {{ds_dsn_url}}
    {{uv}} dlctl ingest dataset {{ds_msdsl_url}}

graphrag-transform: check-dlctl
    {{uv}} dlctl transform -m "+graphs.music_taste.*"

graphrag-test: check-dlctl
    {{uv}} dlctl test -m "+graphs.music_taste.*"

graphrag-export: check-dlctl
    {{uv}} dlctl export dataset graphs "music_taste"

graphrag-etl: graphrag-ingest graphrag-transform graphrag-export


# =================================
# Economic Competition Networks
# =================================

econ-compnet-ingest: check-dlctl
    {{uv}} dlctl ingest dataset -t "atlas" "The Atlas of Economic Complexity"

econ-compnet-transform: check-dlctl
    {{uv}} dlctl transform -m "+graphs.econ_comp.*"

econ-compnet-test: check-dlctl
    {{uv}} dlctl test -m "+graphs.econ_comp.*"

econ-compnet-export: check-dlctl
    {{uv}} dlctl export dataset graphs "econ_comp"

econ-compnet-etl: econ-compnet-ingest econ-compnet-transform econ-compnet-export


# ============================
# MLOps: Datasets for Training
# ============================

mlops-ingest: check-dlctl
    {{uv}} dlctl ingest dataset {{ds_dd_url}}
    {{uv}} dlctl ingest dataset {{ds_dd_monitor_url}}

mlops-transform: check-dlctl
    {{uv}} dlctl transform -m "+stage.dd.*"

mlops-test: check-dlctl
    {{uv}} dlctl test -m "+stage.dd.*"

mlops-etl: mlops-ingest mlops-transform


# =========
# Reporting
# =========

transform models="":
    {{uv}} dlctl transform {{models}}

test models="":
    {{uv}} dlctl test {{models}}

ingest-ls: check-dlctl
    {{uv}} dlctl ingest ls

export-ls: check-dlctl
    {{uv}} dlctl export ls

docs-generate: check-dlctl
    {{uv}} dlctl docs generate

docs-serve: check-dlctl
    {{uv}} dlctl docs serve

catalog-info: check-dlctl
    {{uv}} dlctl tools catalog-info


# ========
# Global
# ========

global-etl: graphrag-etl econ-compnet-etl mlops-etl
global-test: graphrag-test econ-compnet-test mlops-test


# ==========================================
# Development fixtures (no Kaggle account)
# ==========================================

# Upload the small Music Taste fixtures to object storage
seed: check-dlctl
    {{uv}} python -m tests.seed

pytest:
    {{uv}} pytest


# =======
# Infra
# =======

infra-provision-local:
    docker compose -p datalab -f infra/services/docker/compose.yml --profile dev up rustfs -d
    docker compose -p datalab -f infra/services/docker/compose.yml up postgres -d

infra-destroy-local:
    docker compose -p datalab -f infra/services/docker/compose.yml --profile dev down
