# Copy to `.env` to override the defaults used by docker-compose.yml
# and the Python client scripts.

# Server credentials
GIZMOSQL_USERNAME=gizmosql_user
GIZMOSQL_PASSWORD=gizmosql_password
# JWT signing secret (set a real value in any non-local deployment)
SECRET_KEY=local-dev-only-secret-key-change-me

# Client connection (defaults match the compose file)
GIZMOSQL_URI=gizmosql://localhost:31337
GIZMOSQL_TLS_SKIP_VERIFY=1

# Optional: where Divvy CSV files live on the host (stress_test.py)
# DIVVY_DATA_DIR=./data
